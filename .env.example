# Darıca Gücü Maç Merkezi V4 PRO — ortam değişkenleri.
# Gerçek değerleri ASLA bu dosyaya yazma. Vercel > Settings > Environment Variables
# bölümüne gir (hassas olarak işaretle). Yerel geliştirme için bu dosyayı .env.local olarak kopyala.

# --- Zorunlu: zamanlanmış kontrol ---
# Vercel Cron bu değeri Bearer olarak gönderir. Uzun rastgele bir değer üret (en az 32 karakter).
CRON_SECRET=

# --- Zorunlu: özel Blob deposu ---
# Vercel, Blob deposunu projeye bağladığında bunu kendisi ekler.
BLOB_READ_WRITE_TOKEN=

# --- İsteğe bağlı: web push bildirimleri ---
# Üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ornek@alanadi.com

# --- İsteğe bağlı: Claude yapay zeka özeti (varsayılan KAPALI) ---
# Üçü birden doğru girilmedikçe yapay zeka çalışmaz ve uygulama normal çalışmaya devam eder.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Aylık harcama tavanı (USD). Aşılınca yapay zeka kendiliğinden durur.
AI_MONTHLY_BUDGET_USD=5
